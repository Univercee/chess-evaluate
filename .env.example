# Build-time settings. Copy to .env and fill in; .env is not committed.
# Read by vite.config.js (loadEnv) and, for Docker, by docker-compose.yml.
# The GitHub Pages workflow builds .env from the keys listed here, taking each value from the
# variables of the "github-pages" environment (Settings → Environments → github-pages).

# Public site address, without a trailing slash. Enables canonical/og:url/hreflang tags,
# absolute og:image/twitter:image URLs and sitemap.xml. Leave empty to build without them.
SITE_URL=https://univercee.github.io/chess-evaluate

# Not listed as a key on purpose: the Pages workflow derives it from the repository name.
# BASE_PATH=/chess-evaluate/
